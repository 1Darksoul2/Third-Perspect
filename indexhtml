<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Third Perspect</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..800&family=Outfit:wght@400..700&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Hanken+Grotesk:wght@400;500;600;700&family=Syne:wght@500..800&family=DM+Sans:wght@400..700&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
  /* Layout concept: an editorial storefront. Home borrows the chrome-and-lilac poster look,
     Customize borrows the neon look, About borrows the blurred-type look.
     Chrome knot in the hero sits in front of the headline, like the reference. */
  :root {
    --bg: #221A16;
    --surface: #2E2420;
    --surface2: #3A2F29;
    --fg: #F3ECE5;
    --muted: #AC9D91;
    --line: rgba(243, 236, 229, .16);
    --accent: #FFB02E;
    --accent-ink: #2A1600;
    --blue: #5CC3EA;
    --hero-ink: #FFF1D6;
    --logo: url("data:image/webp;base64,");
    --serif: "Fraunces", "Iowan Old Style", Georgia, serif;
    --sans: "Outfit", system-ui, -apple-system, "Segoe UI", sans-serif;
    --ital: italic;
    --hs: 1;
    --err: #FF8A7A;
    --mono: "JetBrains Mono", ui-monospace, Menlo, monospace;
    color-scheme: dark;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) {
      --bg: #EEE8E1; --surface: #E4DCD3; --surface2: #D9CFC4; --fg: #241C17; --muted: #6C5F56;
      --line: rgba(36, 28, 23, .2); --accent: #B04E00; --accent-ink: #FFFFFF; --blue: #146E96; --err: #B3261E; color-scheme: light;
    }
  }
  :root[data-theme="light"] {
    --bg: #EEE8E1; --surface: #E4DCD3; --surface2: #D9CFC4; --fg: #241C17; --muted: #6C5F56;
    --line: rgba(36, 28, 23, .2); --accent: #B04E00; --accent-ink: #FFFFFF; --blue: #146E96; --err: #B3261E; color-scheme: light;
  }

  :root[data-font="editorial"] { --serif: "Bodoni Moda", "Didot", "Bodoni 72", Georgia, serif; --sans: "Hanken Grotesk", system-ui, sans-serif; --ital: italic; --hs: 1; }
  :root[data-font="modern"] { --serif: "Syne", "Arial Black", system-ui, sans-serif; --sans: "DM Sans", system-ui, sans-serif; --ital: normal; --hs: .78; }

  * { box-sizing: border-box; }
  body {
    background: var(--bg); color: var(--fg);
    font-family: var(--sans); font-size: 16px; line-height: 1.6;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
  }
  body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 60; background: var(--bg); }
  .wrap { max-width: 1160px; margin: 0 auto; }
  a { color: inherit; }
  button { font-family: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 500; line-height: 1.02; margin: 0; text-wrap: balance; }
  .micro { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  p { margin: 0; }

  /* header */
  .site { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; background: var(--bg); border-bottom: 1px solid var(--line); }
  .site .in { display: flex; align-items: center; justify-content: space-between; gap: 10px 24px; padding-block: 14px; flex-wrap: wrap; }
  .brand { font-family: var(--serif); font-style: var(--ital); font-weight: 600; font-size: 24px; line-height: 1.1; text-decoration: none; display: flex; align-items: center; gap: 10px; }
  .brand i { width: 42px; height: 42px; flex: none; border-radius: 50%; background: var(--logo) center / cover no-repeat; display: inline-block; }
  .nav { display: flex; gap: 6px 22px; flex-wrap: wrap; }
  .nav a { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; text-decoration: none; color: var(--muted); padding: 6px 0; border-bottom: 1px solid transparent; }
  .nav a:hover { color: var(--fg); }
  .nav a[aria-current="page"] { color: var(--fg); border-bottom-color: var(--accent); }
  .tools { display: flex; align-items: center; gap: 10px; }
  .iconbtn { background: transparent; border: 1px solid var(--line); border-radius: 999px; height: 38px; padding: 0 14px; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
  .iconbtn:hover { border-color: var(--fg); }
  .iconbtn b { background: var(--accent); color: var(--accent-ink); border-radius: 999px; min-width: 20px; height: 20px; display: inline-grid; place-items: center; font-size: 11px; font-family: var(--mono); font-weight: 500; }

  .btn { display: inline-flex; align-items: center; gap: 10px; font: 600 12px var(--sans); letter-spacing: .16em; text-transform: uppercase; background: var(--accent); color: var(--accent-ink); border: 1px solid var(--accent); border-radius: 999px; padding: 15px 26px; cursor: pointer; text-decoration: none; }
  .btn:hover { filter: brightness(1.08); }
  .btn.ghost { background: transparent; color: var(--fg); border-color: var(--fg); }
  .btn.small { padding: 10px 16px; font-size: 11px; }

  .view { padding-block: 0 20px; }
  .pad { padding-block: 84px 0; }
  .sec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 14px 30px; flex-wrap: wrap; margin-bottom: 32px; }
  .sec-head h2 { font-size: calc(clamp(34px, 5.4vw, 62px) * var(--hs)); font-style: var(--ital); }
  .sec-head p { max-width: 46ch; color: var(--muted); }

  /* hero (home) */
  .hero { position: relative; margin-top: 22px; border-radius: 14px; overflow: hidden; min-height: 600px; background: radial-gradient(ellipse at 50% 50%, rgba(10, 8, 6, 0) 30%, rgba(10, 8, 6, .5) 100%), linear-gradient(100deg, #1B7FA6 0 49.7%, #0d0b09 49.7% 50.3%, #D9561A 50.3% 100%); color: var(--hero-ink); display: flex; align-items: center; isolation: isolate; }
  .hero::after { content: ""; position: absolute; inset: 14px; border: 1px solid rgba(255, 241, 214, .38); border-radius: 8px; pointer-events: none; z-index: 4; }
  .hero-title { position: relative; z-index: 1; width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 0 clamp(26px, 5vw, 56px); margin: 0; font-style: var(--ital); font-weight: 500; text-transform: uppercase; font-size: calc(clamp(50px, 8.8vw, 112px) * var(--hs)); letter-spacing: -.02em; line-height: .9; font-variation-settings: "opsz" 96; }
  #knot { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; }
  .fallback { position: absolute; z-index: 2; left: 50%; top: 50%; width: min(60%, 430px); aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; background: conic-gradient(from 20deg, #f2fbff, #3aa0cc, #2b2019, #f0a050, #f2fbff); -webkit-mask: radial-gradient(circle, transparent 36%, #000 38%); mask: radial-gradient(circle, transparent 36%, #000 38%); }
  .hero.gl .fallback { display: none; }
  .hero .micro { color: rgba(255, 241, 214, .92); position: absolute; z-index: 5; line-height: 1.7; }
  .hero .tl { left: 34px; top: 34px; }
  .hero .tr { right: 34px; bottom: 34px; text-align: right; }
  .explore { position: absolute; z-index: 5; left: 34px; bottom: 32px; display: flex; align-items: center; gap: 14px; color: var(--hero-ink); text-decoration: none; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; line-height: 1.5; }
  .explore span { width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--hero-ink); display: grid; place-items: center; font-size: 18px; letter-spacing: 0; }
  .explore:hover span { background: var(--hero-ink); color: #3b2d25; }
  .vert { position: absolute; z-index: 5; right: 34px; top: 34px; writing-mode: vertical-rl; color: rgba(255, 241, 214, .92); }

  .trust { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
  .trust div { padding: 22px 20px 22px 0; }
  .trust div + div { padding-left: 20px; border-left: 1px solid var(--line); }
  .trust b { display: block; font-family: var(--serif); font-style: var(--ital); font-weight: 500; font-size: 22px; line-height: 1.2; margin-bottom: 4px; }
  .trust span { color: var(--muted); font-size: 14px; }

  /* categories */
  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .tile { text-align: left; display: grid; grid-template-columns: minmax(0, 1fr) 96px; gap: 8px; align-items: end; padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; cursor: pointer; min-height: 150px; transition: border-color .15s, transform .15s; }
  .tile:hover { border-color: var(--accent); transform: translateY(-2px); }
  .tile[aria-pressed="true"] { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .tile h3 { font-size: 26px; font-style: var(--ital); margin: 8px 0 6px; }
  .tile p { color: var(--muted); font-size: 14px; line-height: 1.4; }
  .cv { position: relative; aspect-ratio: 1 / 1; }
  .cv canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* products */
  .toolbar { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; justify-content: space-between; margin-block: 30px 22px; padding-block: 14px; border-block: 1px solid var(--line); }
  .toolbar .grp { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  input, select, textarea { font: 400 15px var(--sans); color: var(--fg); background: transparent; border: 1px solid var(--line); border-radius: 8px; padding: 11px 13px; width: 100%; min-width: 0; }
  select { background: var(--bg); }
  input:focus, select:focus, textarea:focus { border-color: var(--accent); outline: none; }
  .toolbar input { width: 240px; max-width: 100%; }
  .toolbar select { width: auto; }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px 18px; }
  .pcard { display: flex; flex-direction: column; gap: 12px; cursor: pointer; min-width: 0; }
  .pimg { position: relative; background: var(--surface); border-radius: 12px; border: 1px solid var(--line); overflow: hidden; }
  .pimg .cv { aspect-ratio: 1 / 1.08; }
  .pcard:hover .pimg { border-color: var(--accent); }
  .flag { position: absolute; left: 10px; top: 10px; z-index: 1; font: 500 10px var(--mono); letter-spacing: .12em; text-transform: uppercase; background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 3px 9px; }
  .pbody h3 { font-size: 22px; font-style: var(--ital); margin: 4px 0 8px; }
  .prow { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
  .price { font-weight: 700; font-variant-numeric: tabular-nums; }
  .empty { grid-column: 1 / -1; padding: 40px 0; color: var(--muted); }

  /* neon band (home teaser and customize) */
  .neon { position: relative; overflow: hidden; border-radius: 14px; background: radial-gradient(ellipse at 78% 30%, #4a2108 0%, #0a1118 58%, #05070b 100%); color: #EDE9FF; border: 1px solid rgba(143, 211, 255, .25); }
  .neon .in { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 30px; align-items: center; padding: clamp(26px, 5vw, 60px); }
  .neon h2, .neon h1 { font-style: var(--ital); font-weight: 500; font-size: calc(clamp(46px, 8vw, 104px) * var(--hs)); line-height: .95; text-transform: uppercase; letter-spacing: -.01em; }
  .neon .l1 { display: block; color: #9ADBFF; text-shadow: 0 0 10px rgba(110, 190, 255, .9), 0 0 36px rgba(70, 130, 255, .8); }
  .neon .l2 { display: block; color: #FFA94D; text-shadow: 0 0 10px rgba(255, 150, 60, .9), 0 0 36px rgba(255, 100, 20, .75); }
  .neon p { color: #C9C3E6; max-width: 44ch; margin: 22px 0 28px; }
  .neon .micro { color: #9ADBFF; }
  .neon .cv { max-width: 380px; margin-inline: auto; width: 100%; aspect-ratio: 1 / 1.1; }
  .neon .btn { background: #9ADBFF; color: #06101c; border-color: #9ADBFF; box-shadow: 0 0 24px rgba(110, 190, 255, .55); }
  .neon .btn.ghost { background: transparent; color: #FFA94D; border-color: #FFA94D; box-shadow: 0 0 20px rgba(255, 150, 60, .35); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); counter-reset: s; }
  .steps li { counter-increment: s; padding: 22px 20px 0 0; }
  .steps li + li { padding-left: 20px; border-left: 1px solid var(--line); }
  .steps li::before { content: "Step " counter(s); font: 500 11px var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .steps h3 { font-size: 26px; font-style: var(--ital); margin: 10px 0 6px; }
  .steps p { color: var(--muted); font-size: 15px; }

  /* customize */
  .cust { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: 36px; align-items: start; margin-top: 44px; }
  .fs { border: 1px solid var(--line); border-radius: 12px; padding: 22px; margin: 0 0 18px; min-width: 0; }
  .fs legend { font: 500 11px var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); padding: 0 8px; }
  .fs h3 { font-size: 24px; font-style: var(--ital); margin: 0 0 14px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .field { display: grid; gap: 6px; min-width: 0; }
  .field.full { grid-column: 1 / -1; }
  label.l { font: 500 11px var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .chips { display: flex; gap: 10px; flex-wrap: wrap; }
  .chip { background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 9px 16px; cursor: pointer; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; }
  .chip:hover { border-color: var(--fg); }
  .chip[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .sw { width: 34px; height: 34px; border-radius: 50%; border: 2px solid var(--line); cursor: pointer; padding: 0; background: var(--c); }
  .sw[aria-pressed="true"] { outline: 2px solid var(--accent); outline-offset: 3px; border-color: var(--bg); }
  .range { display: flex; align-items: center; gap: 14px; }
  .range input { padding: 0; accent-color: var(--accent); border: 0; }
  .range output { font-family: var(--mono); min-width: 74px; text-align: right; }
  .preview { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 92px); background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 18px; }
  .preview .cv { aspect-ratio: 1 / 1; background: var(--bg); border-radius: 10px; border: 1px solid var(--line); }
  .bill { margin: 16px 0 0; padding: 0; display: grid; gap: 7px; font-size: 14px; }
  .bill div { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); }
  .bill dd { margin: 0; color: var(--fg); font-variant-numeric: tabular-nums; text-align: right; }
  .bill dt { margin: 0; }
  .total { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin: 14px 0 4px; padding-top: 14px; border-top: 1px solid var(--line); }
  .total strong { font-family: var(--serif); font-style: var(--ital); font-weight: 500; font-size: 34px; font-variant-numeric: tabular-nums; }
  .note { font-size: 13px; color: var(--muted); }
  .status { min-height: 1.5em; font-size: 14px; color: var(--accent); margin-top: 10px; }

  /* about */
  .about-hero { position: relative; overflow: hidden; margin-top: 22px; border-radius: 14px; border: 1px solid var(--line); background-image: linear-gradient(to right, var(--line) 1px, transparent 1px); background-size: 12.5% 100%; padding: clamp(36px, 6vw, 80px) clamp(22px, 5vw, 60px); }
  .blurry { position: relative; isolation: isolate; font-weight: 800; font-size: calc(clamp(50px, 10vw, 132px) * var(--hs)); line-height: .92; letter-spacing: -.02em; font-variation-settings: "opsz" 96; }
  .blurry::before, .blurry::after { content: attr(data-t); position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .blurry::before { color: #FF8A2B; filter: blur(18px); opacity: .75; transform: translate(.09em, .035em); }
  .blurry::after { filter: blur(5px); opacity: .45; transform: translate(-.04em, 0); }
  .about-hero p { max-width: 50ch; margin-top: 28px; color: var(--muted); font-size: 18px; }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--line); margin-top: 40px; }
  .stats div { padding: 24px 18px 24px 0; }
  .stats div + div { padding-left: 18px; border-left: 1px solid var(--line); }
  .stats strong { display: block; font-family: var(--serif); font-style: var(--ital); font-weight: 500; font-size: clamp(34px, 5vw, 54px); line-height: 1; font-variant-numeric: tabular-nums; }
  .cols3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; }
  .cols3 h3 { font-size: 26px; font-style: var(--ital); margin-bottom: 8px; }
  .cols3 p { color: var(--muted); }
  .projects { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .proj { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; min-width: 0; }
  .proj .cv { aspect-ratio: 16 / 11; border-bottom: 1px solid var(--line); background: var(--surface2); }
  .proj .pb { padding: 18px 18px 20px; display: grid; gap: 8px; }
  .proj h3 { font-size: 24px; font-style: var(--ital); }
  .proj p { color: var(--muted); font-size: 15px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 14px; }

  /* contact */
  .contact { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 44px; margin-top: 44px; }
  .info p { margin-bottom: 20px; }
  .info .v { font-family: var(--serif); font-style: var(--ital); font-size: 24px; user-select: all; overflow-wrap: anywhere; }
  details { border-top: 1px solid var(--line); padding: 16px 0; }
  details:last-of-type { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; font-family: var(--serif); font-style: var(--ital); font-size: 22px; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-family: var(--sans); font-style: normal; }
  details[open] summary::after { content: "\2212"; }
  details p { color: var(--muted); margin-top: 10px; max-width: 60ch; }

  /* page footer */
  footer { margin-top: 90px; border-top: 1px solid var(--line); padding-block: 40px 44px; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 28px; }
  footer h4 { margin: 0 0 12px; }
  footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 15px; color: var(--muted); }
  footer a { text-decoration: none; }
  footer a:hover { color: var(--fg); }
  .news { display: flex; gap: 8px; margin-top: 10px; }
  .news input { flex: 1; }
  .legal { grid-column: 1 / -1; padding-top: 22px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

  /* drawer + modal */
  .scrim { position: fixed; inset: 0; background: rgba(8, 5, 4, .6); z-index: 80; }
  .drawer { position: fixed; z-index: 90; top: 0; right: 0; bottom: 0; width: min(420px, 100%); background: var(--bg); border-left: 1px solid var(--line); display: flex; flex-direction: column; padding: calc(env(safe-area-inset-top, 0px) + 20px) max(20px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 20px) 20px; }
  .drawer header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
  .drawer h2 { font-size: 30px; font-style: var(--ital); }
  .items { flex: 1; overflow-y: auto; display: grid; gap: 14px; align-content: start; }
  .item { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .item .cv { aspect-ratio: 1 / 1; background: var(--surface); border-radius: 8px; }
  .item h4 { margin: 0; font-family: var(--serif); font-style: var(--ital); font-size: 19px; font-weight: 500; }
  .qty { display: inline-flex; align-items: center; gap: 4px; border: 1px solid var(--line); border-radius: 999px; margin-top: 6px; }
  .qty button { background: transparent; border: 0; width: 28px; height: 28px; cursor: pointer; font-size: 16px; }
  .qty span { min-width: 22px; text-align: center; font-family: var(--mono); font-size: 13px; }
  .linkbtn { background: none; border: 0; cursor: pointer; color: var(--muted); font-size: 12px; text-decoration: underline; padding: 0; }
  .ship { margin: 14px 0; font-size: 13px; color: var(--muted); }
